  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
    <TargetName>$(ProjectName)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>fltMgr.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Required since Phase 7 step 4: PsSetCreateProcessNotifyRoutineEx
           (and Ex2, and the thread/image-load notify equivalents)
           unconditionally return STATUS_ACCESS_DENIED unless the driver
           image has IMAGE_DLLCHARACTERISTICS_FORCE_INTEGRITY set in its PE
           header - confirmed via Microsoft Learn/community docs after
           hitting exactly this failure on this machine, not assumed
           up front. Testsigning mode still satisfies the resulting
           page-hash verification the same way it already satisfies the
           plain driver-load signature check - no new certificate needed. -->
      <AdditionalOptions>/integritycheck %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <!-- Uses the WDK build system's own built-in test-signing step (a
         separate mechanism from a custom PostBuildEvent) - it auto-manages
         its own local test certificate, which is the supported VS/WDK
         workflow for testsigning-mode driver development. Explicit SHA256
         is required - an empty FileDigestAlgorithm makes the underlying
         signtool call omit /fd entirely, which current signtool rejects. -->
    <DriverSign>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>fltMgr.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Required since Phase 7 step 4: PsSetCreateProcessNotifyRoutineEx
           (and Ex2, and the thread/image-load notify equivalents)
           unconditionally return STATUS_ACCESS_DENIED unless the driver
           image has IMAGE_DLLCHARACTERISTICS_FORCE_INTEGRITY set in its PE
           header - confirmed via Microsoft Learn/community docs after
           hitting exactly this failure on this machine, not assumed
           up front. Testsigning mode still satisfies the resulting
           page-hash verification the same way it already satisfies the
           plain driver-load signature check - no new certificate needed. -->
      <AdditionalOptions>/integritycheck %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="kinnector_filter.c" />
